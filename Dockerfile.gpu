# syntax=docker/dockerfile:1
#
# smith for a provider's GPU node: the same agent as Dockerfile, with a lock
# of CUDA torch per Python (runtime/cp312.json and the others) that it fetches
# and installs into a job's environment, and nvcc for TileLang's kernels.
#
#   docker build -f Dockerfile.gpu -t smith-gpu .
#
# No Ravex and no Moonclip in it (GPU-523): a job carries its template - its
# Python, the torch of the lock, and the Ravex and Moonclip it trains with -
# and smith makes that environment on the node (environment.py), so a release
# of either needs no new image. Run on a node with the NVIDIA container toolkit:
#
#   docker run --gpus all --init #     -e SMITH_BACKEND=https://... -e SMITH_TOKEN=... #     -e SMITH_HARDWARE=gpu-a100 #     -e SMITH_STORAGE_BUCKET=... -e SMITH_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com #     -e MOONCLIP_S3_ACCESS_KEY=... -e MOONCLIP_S3_SECRET_KEY=... #     smith-gpu

# ─── runtime: torch and its CUDA libraries, never in the image ─────────
# **Fetched by the node, not pulled with the image** (runtime.py). torch with
# CUDA is ~7 GB, and in the image it was layers of about a gigabyte that a
# host's docker pulled from the registry before smith could say a word: on
# 2026-10-29 two marketplace hosts in a row spent more than ten minutes on
# it, a layer dropping halfway and starting again from nothing, and never
# started. So the image carries only the lock, runtime.json - each wheel's
# name, address and sha256 - and smith fetches the wheels when the node starts,
# in pieces, several at once: from the backend's cache when the node uses it
# (SMITH_CACHE=backend), else from a mirror if SMITH_RUNTIME_URL is set, else
# from the index they were resolved from. The cache's copies are uploaded by
# .github/workflows/CD.yml, from this lock, as soon as the image is
# published and again every hour.
#
# Resolved from runtime.in once per Python a job may ask for (GPU-523), each
# in a stage of that Python (runtime-lock.sh), with both indexes: torch is
# pinned with its local version, which only the cu128 index has, so PyPI
# cannot offer a newer one; everything else is pinned by torch or free to be
# the newest of either. Then fetched and installed once in that stage, which
# the image does not keep, so a lock that cannot be installed fails the build
# and not a node.
# The `bundle` target below is these wheels alone, for whoever fills a cache
# or a mirror with them.
FROM python:3.11-slim-bookworm AS runtime-311
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 TORCH_INDEX=https://download.pytorch.org/whl/cu128
COPY runtime.in runtime.py runtime-lock.sh /lock/
RUN --mount=type=cache,target=/root/.cache/pip sh /lock/runtime-lock.sh

FROM python:3.12-slim-bookworm AS runtime-312
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 TORCH_INDEX=https://download.pytorch.org/whl/cu128
COPY runtime.in runtime.py runtime-lock.sh /lock/
RUN --mount=type=cache,target=/root/.cache/pip sh /lock/runtime-lock.sh

FROM python:3.13-slim-bookworm AS runtime-313
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 TORCH_INDEX=https://download.pytorch.org/whl/cu128
COPY runtime.in runtime.py runtime-lock.sh /lock/
RUN --mount=type=cache,target=/root/.cache/pip sh /lock/runtime-lock.sh

# docker build --target bundle --output type=local,dest=<dir>: the wheels,
# named as a cache (under runtime/) or a mirror serves them.
FROM scratch AS bundle
COPY --from=runtime-311 /runtime/wheels/ /
COPY --from=runtime-312 /runtime/wheels/ /
COPY --from=runtime-313 /runtime/wheels/ /

# ─── run: what the node pulls ──────────────────────────────────────────
# Slim Python rather than a CUDA base image: torch's CUDA wheels carry their
# own CUDA libraries, and all the node has to provide is the driver, which the
# container toolkit mounts in. One interpreter, the one the wheels were built
# for, instead of a CUDA image's and a second one beside it.
#
# **No layer over 250 MB** (GPU-225). A host pulls the layers in parallel, and
# one that drops starts again from its first byte: the smaller they are, the
# less a dropped connection costs. Each RUN below is one layer, split where
# it would grow past that; the build's last step checks it.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The compiler TileLang builds a kernel with on first use: nvcc, the CUDA
# runtime's headers and CCCL, and g++ as nvcc's host compiler. From NVIDIA's
# apt repository at 12.8, the line torch was built for. Not from pip: at 12.x
# NVIDIA's nvcc wheel carries ptxas and NVVM but no nvcc binary, and
# TileLang's own `nvcc` extra asks for CUDA 13, whose output the 570 drivers
# this image is for may not load. Found by compiling the kernels in this image
# on a machine without a GPU - lowering and nvcc need none.
# git is for a job that brings a repository's commit (code = true): the
# node fetches that commit alone.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/keyring.deb \
      https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i /tmp/keyring.deb && rm /tmp/keyring.deb \
    && apt-get update && apt-get install -y --no-install-recommends cuda-nvcc-12-8 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends cuda-cudart-dev-12-8 cuda-cccl-12-8 \
    && rm -rf /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda-12.8     PATH="/usr/local/cuda-12.8/bin:${PATH}"

# uv makes each job's environment from its template (environment.py,
# GPU-523): the Python it asks for, the lock's torch, Ravex and Moonclip, and
# what Ravex samples the machine with (psutil, nvidia-ml-py); and installs a
# repository's requirements on top.
# Pinned (GPU-530): uv makes every job's environment, and an unpinned one was
# whatever PyPI had on the day the image was built. Moved by hand, to a
# release at least two weeks old; Dependabot reads no pin in a RUN line.
RUN pip install uv==0.13.8

# The job runs as `job` and smith as root (GPU-530), as in Dockerfile: a
# dependency of the job can then neither read smith's token and the
# machine's keys under /proc nor write what the next job runs. The GPUs are
# the container toolkit's /dev/nvidia*, which any user may open.
RUN useradd --no-create-home --uid 10001 --user-group job
ENV SMITH_JOB_USER=job
# Root's and read-only to anyone else (GPU-530), as in Dockerfile.
COPY . /app/smith
RUN chmod -R u=rwX,go=rX /app/smith
# The locks of what a job's environment fetches (runtime.py), not the wheels.
COPY --from=runtime-311 /runtime/cp311.json /app/runtime/cp311.json
COPY --from=runtime-312 /runtime/cp312.json /app/runtime/cp312.json
COPY --from=runtime-313 /runtime/cp313.json /app/runtime/cp313.json
WORKDIR /app

# The tag this image is published as, which smith writes at the top of every
# job's output: `latest` moves, and a host may start a node from an older
# copy of it. Last, so a new tag rebuilds nothing above.
ARG SMITH_IMAGE=""
ENV SMITH_IMAGE=${SMITH_IMAGE}

CMD ["python", "smith/smith.py", "--config", "smith/smith.gpu.toml"]
