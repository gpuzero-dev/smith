# syntax=docker/dockerfile:1
#
# smith for a provider's GPU node: the same agent as Dockerfile, with the
# lock of CUDA torch (runtime.json) that it fetches and installs when the node
# starts, and the NVIDIA management library, so a job asking for a GPU gets
# one and Ravex can sample it.
#
#   docker build -f Dockerfile.gpu -t smith-gpu .
#
# Moonclip and Ravex from PyPI by default, or compiled from checkouts with
# LIBS=source and the two contexts, as in Dockerfile:
#
#   docker build -f Dockerfile.gpu -t smith-gpu --build-arg LIBS=source \
#     --build-context moonclip=../moonclip --build-context ravex=../ravex .
#
# and run on a node with the NVIDIA container toolkit:
#
#   docker run --gpus all --init \
#     -e SMITH_BACKEND=https://... -e SMITH_TOKEN=... \
#     -e SMITH_HARDWARE=gpu-a100 \
#     -e SMITH_STORAGE_BUCKET=... -e SMITH_STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com \
#     -e MOONCLIP_S3_ACCESS_KEY=... -e MOONCLIP_S3_SECRET_KEY=... \
#     smith-gpu
#
# Either way the libraries arrive as wheels made in a stage of their own, so
# the compiler a source build needs stays behind: a rented node pulls this
# image before it can do anything, and a Rust toolchain is a gigabyte it would
# pull for nothing.
ARG LIBS=pypi

# ─── wheels: from PyPI ─────────────────────────────────────────────────
FROM python:3.12-bookworm AS wheels-pypi
ARG MOONCLIP_VERSION=0.3.1
ARG RAVEX_VERSION=0.10.1
RUN pip download --no-deps --only-binary=:all: -d /wheels \
      "moonclip==${MOONCLIP_VERSION}" "ravex==${RAVEX_VERSION}"
# The scripts smith.gpu.toml offers are Ravex's examples and GPU benches, which
# the wheel does not carry: taken from the release's tag, so they match the
# library. A bench newer than the release is not there, and a job naming it
# fails at start saying so.
RUN curl -fsSL "https://github.com/gpuzero-dev/ravex/archive/refs/tags/v${RAVEX_VERSION}.tar.gz" \
      | tar -xz -C /tmp \
    && mv "/tmp/ravex-${RAVEX_VERSION}/examples" /examples \
    && mv "/tmp/ravex-${RAVEX_VERSION}/bench" /bench

# ─── wheels: from checkouts ────────────────────────────────────────────
FROM python:3.12-bookworm AS wheels-source

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/root/.cargo/bin:${PATH}"

# The version Moonclip pins in its rust-toolchain.toml (see Dockerfile).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.98.1 --profile minimal --component clippy \
    && pip install maturin

COPY --from=moonclip . /src/moonclip
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/moonclip/target \
    maturin build --release --locked -m /src/moonclip/Cargo.toml --out /wheels

# Ravex is pure Python since GPU-267: a plain wheel, no cargo.
COPY --from=ravex . /src/ravex
RUN pip wheel --no-deps --wheel-dir /wheels /src/ravex \
    && cp -r /src/ravex/examples /examples && cp -r /src/ravex/bench /bench

FROM wheels-${LIBS} AS wheels

# ─── runtime: torch and its CUDA libraries, never in the image ─────────
# **Fetched by the node, not pulled with the image** (runtime.py). torch with
# CUDA is ~7 GB, and in the image it was layers of about a gigabyte that a
# host's docker pulled from the registry before smith could say a word: on
# 2026-10-29 two marketplace hosts in a row spent more than ten minutes on
# it, a layer dropping halfway and starting again from nothing, and never
# started. So the image carries only the lock, runtime.json - each wheel's
# name, address and sha256 - and smith fetches the wheels when the node starts,
# in pieces, several at once: from the backend's cache when the node uses it
# (SMITH_CACHE=backend), else from a mirror if SMITH_RUNTIME_URL is set, else
# from the index they were resolved from.
#
# Resolved here from runtime.in, with both indexes: torch is pinned with its
# local version, which only the cu128 index has, so PyPI cannot offer a newer
# one; everything else is pinned by torch or free to be the newest of either.
# Then fetched and installed once in this stage, which the image does not
# keep, so a lock that cannot be installed fails the build and not a node.
# The `bundle` target below is these wheels alone, for whoever fills a cache
# or a mirror with them.
FROM python:3.12-slim-bookworm AS runtime
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
ARG TORCH_INDEX=https://download.pytorch.org/whl/cu128
COPY runtime.in runtime.py /lock/
# pip reads a wheel's dependencies from the wheel itself where the index
# offers no metadata of its own, as the cu128 one does not: resolving is
# downloading it all once, so its cache is kept between builds.
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_NO_CACHE_DIR= pip install --dry-run --ignore-installed --quiet --report /lock/report.json \
      --index-url ${TORCH_INDEX} --extra-index-url https://pypi.org/simple -r /lock/runtime.in \
    && python /lock/runtime.py lock --report /lock/report.json --out /runtime/runtime.json \
    && python /lock/runtime.py fetch --manifest /runtime/runtime.json --dir /runtime/wheels
RUN pip install --no-deps --no-index /runtime/wheels/*.whl \
    && pip check \
    && python -c "import torch; assert torch.__version__ == '2.11.0+cu128', torch.__version__"

# docker build --target bundle --output type=local,dest=<dir>: the wheels,
# named as a cache (under runtime/) or a mirror serves them.
FROM scratch AS bundle
COPY --from=runtime /runtime/wheels/ /

# ─── run: what the node pulls ──────────────────────────────────────────
# Slim Python rather than a CUDA base image: torch's CUDA wheels carry their
# own CUDA libraries, and all the node has to provide is the driver, which the
# container toolkit mounts in. One interpreter, the one the wheels were built
# for, instead of a CUDA image's and a second one beside it.
#
# **No layer over 250 MB** (GPU-225). A host pulls the layers in parallel, and
# one that drops starts again from its first byte: the smaller they are, the
# less a dropped connection costs. Each RUN below is one layer, split where
# it would grow past that; the build's last step checks it.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# The compiler TileLang builds a kernel with on first use: nvcc, the CUDA
# runtime's headers and CCCL, and g++ as nvcc's host compiler. From NVIDIA's
# apt repository at 12.8, the line torch was built for. Not from pip: at 12.x
# NVIDIA's nvcc wheel carries ptxas and NVVM but no nvcc binary, and
# TileLang's own `nvcc` extra asks for CUDA 13, whose output the 570 drivers
# this image is for may not load. Found by compiling the kernels in this image
# on a machine without a GPU - lowering and nvcc need none.
# git is for a job that brings a repository's commit (code = true): the
# node fetches that commit alone.
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends g++ \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/keyring.deb \
      https://developer.download.nvidia.com/compute/cuda/repos/debian12/x86_64/cuda-keyring_1.1-1_all.deb \
    && dpkg -i /tmp/keyring.deb && rm /tmp/keyring.deb \
    && apt-get update && apt-get install -y --no-install-recommends cuda-nvcc-12-8 \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update && apt-get install -y --no-install-recommends cuda-cudart-dev-12-8 cuda-cccl-12-8 \
    && rm -rf /var/lib/apt/lists/*
ENV CUDA_HOME=/usr/local/cuda-12.8     PATH="/usr/local/cuda-12.8/bin:${PATH}"

# psutil for CPU and RAM, nvidia-ml-py (imported as pynvml) for the GPUs:
# Ravex samples each only if it is importable, and says nothing otherwise.
# uv installs what a repository's requirements ask for, in its venv, much
# faster than pip; without it smith falls back to pip.
RUN pip install psutil nvidia-ml-py uv

COPY --from=wheels /wheels /wheels
RUN pip install /wheels/*.whl && rm -rf /wheels

# The scripts smith.gpu.toml offers. Sources, if any, stayed in their stage.
COPY --from=wheels /examples /app/examples
COPY --from=wheels /bench /app/bench
COPY . /app/smith
# The lock of what the node fetches at start (runtime.py), not the wheels.
COPY --from=runtime /runtime/runtime.json /app/runtime.json
WORKDIR /app

# The tag this image is published as, which smith writes at the top of every
# job's output: `latest` moves, and a host may start a node from an older
# copy of it. Last, so a new tag rebuilds nothing above.
ARG SMITH_IMAGE=""
ENV SMITH_IMAGE=${SMITH_IMAGE}

CMD ["python", "smith/smith.py", "--config", "smith/smith.gpu.toml"]
